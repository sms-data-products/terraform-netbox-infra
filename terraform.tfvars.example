# --- IPAM: RIRs (overriding defaults to keep it minimal for testing) ---
rirs = {
  "RFC1918" = { name = "RFC1918" },
  "ARIN"    = { name = "ARIN" }
}
 
# --- IPAM: Aggregates ---
aggregates = {
  "lab_class_a" = { prefix = "10.0.0.0/8", rir = "RFC1918" },
  "lab_class_c" = { prefix = "192.168.0.0/16", rir = "RFC1918" }
}
 
# --- IPAM: VLANs & Prefixes ---
# Keys must be unique strings — use descriptive names to avoid HCL's
# silent duplicate-key dropping (the example file's numeric keys collide
# when the same VLAN ID appears across multiple sites).
vlans = {
  "use_vlan10_mgmt" = {
    name        = "USE-MGMT"
    vid         = 10
    site        = "lab_us_east"
    prefix      = "10.10.10.0/24"
    description = "US-East Management"
  },
  "use_vlan20_servers" = {
    name        = "USE-SERVERS"
    vid         = 20
    site        = "lab_us_east"
    prefix      = "10.10.20.0/24"
    description = "US-East Servers"
  },
  "use_vlan30_users" = {
    name        = "USE-USERS"
    vid         = 30
    site        = "lab_us_east"
    prefix      = "10.10.30.0/24"
    description = "US-East End Users"
  },
  "use_vlan99_dmz" = {
    name        = "USE-DMZ"
    vid         = 99
    site        = "lab_us_east"
    prefix      = "10.10.99.0/24"
    description = "US-East DMZ"
  },
  "use_vlan100_iot" = {
    name        = "USE-IOT"
    vid         = 100
    site        = "lab_us_east"
    prefix      = "10.10.100.0/24"
    description = "US-East IoT"
    status      = "reserved"
  },
  "euw_vlan10_mgmt" = {
    name        = "EUW-MGMT"
    vid         = 10
    site        = "lab_eu_west"
    prefix      = "10.20.10.0/24"
    description = "EU-West Management"
  },
  "euw_vlan20_servers" = {
    name        = "EUW-SERVERS"
    vid         = 20
    site        = "lab_eu_west"
    prefix      = "10.20.20.0/24"
    description = "EU-West Servers"
  }
}