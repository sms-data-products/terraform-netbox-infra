    role        = "Access Switch"
    platform    = "Cisco IOS-XE"
    device_type = "Catalyst 9300-48S"
    has_vc      = false
    vdcs        = []
    rack_position = 21
    rack_face     = "front"
  },
  # US East — Perimeter firewall with virtual contexts
  "use_fw01" = {
    name        = "USE-FW01"
    rack        = "use_rack_01"
    role        = "Firewall"
    platform    = "Palo Alto PAN-OS"
    device_type = "PA-3050"
    has_vc      = false
    vdcs        = ["VSYS-CORP", "VSYS-DMZ", "VSYS-MGMT"]
