    has_vc      = false
    vdcs        = []
    rack_position = 21
    rack_face     = "front"
  },
 
  # US East — Servers in Main Server Room (R01)
  "use_srv01" = {
    name        = "USE-SRV01"
    rack        = "use_rack_01"
    role        = "Server"
    platform    = "Red Hat Enterprise Linux"
    device_type = "ProLiant DL380 Gen10"
    has_vc      = false
    vdcs        = []
    rack_position = 23
    rack_face     = "front"
  },
  "use_srv02" = {
    name        = "USE-SRV02"
    rack        = "use_rack_01"
    role        = "Server"
    platform    = "Windows Server 2022"
    device_type = "ProLiant DL380 Gen10"
    has_vc      = false
    vdcs        = []
    rack_position = 25
    rack_face     = "front"
  },
 
  # US East — Servers in Main Server Room (R02)
  "use_srv03" = {
    name        = "USE-SRV03"
    rack        = "use_rack_02"
    role        = "Server"
    platform    = "Red Hat Enterprise Linux"
    device_type = "PowerEdge R740"
    has_vc      = false
    vdcs        = []
    rack_position = 22
    rack_face     = "front"
  },
  "use_srv04" = {
    name        = "USE-SRV04"
