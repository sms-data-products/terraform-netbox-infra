# NetBox Connection
#netbox_url   = "https://netbox.example.com"
#netbox_token = "your-api-token-here"
netbox_insecure = true

# --- Organizational Hierarchy & Sites ---
infrastructure_map = {
  "lab_us_east" = {
    region       = "North America"
    tenant_group = "Lab Infrastructure"
    tenant_name  = "Network Lab"
    site_name    = "LAB-USE-01"
    status       = "active"
    locations    = ["Main Server Room", "IDF-Floor-1", "IDF-Floor-2"]
  },
  "lab_eu_west" = {
    region       = "Europe"
    tenant_group = "Lab Infrastructure"
    tenant_name  = "Network Lab"
    site_name    = "LAB-EUW-01"
    status       = "active"
    locations    = ["Server Closet", "MDF"]
  }
}
 
# --- Racks ---
racks_map = {
  "use_rack_01" = {
    name     = "R01"
    site     = "lab_us_east"
    location = "Main Server Room"
    status   = "active"
      u_height  = 42
      width    = "19"
  },
  "use_rack_02" = {
    name     = "R02"
    site     = "lab_us_east"
    location = "Main Server Room"
    status   = "active"
    u_height  = 42
    width    = "19"
  },
  "use_idf1_rack_01" = {
    name     = "IDF1-R01"
    site     = "lab_us_east"
    location = "IDF-Floor-1"
    status   = "active"
    u_height  = 42
    width    = "19"
  },
  "euw_rack_01" = {
    name     = "R01"
    site     = "lab_eu_west"
    location = "Server Closet"
    status   = "active"
    u_height  = 42
    width    = "19"
  }
}
 
# --- Devices ---
# Note: device_type values must match the "Model" field in NetBox exactly.
devices_map = {
  # US East — Core switches in a Virtual Chassis pair
  "use_core_sw01" = {
    name        = "USE-CORE-SW01"
    rack        = "use_rack_01"
    role        = "Core Switch"
    platform    = "Cisco NX-OS"
    device_type = "Nexus 93180YC-FX"
    has_vc      = true
    vdcs        = []
    rack_position = 21
    rack_face     = "front"
  },
  "use_core_sw02" = {
    name        = "USE-CORE-SW02"
    rack        = "use_rack_02"
    role        = "Core Switch"
    platform    = "Cisco NX-OS"
    device_type = "Nexus 93180YC-FX"
    has_vc      = true
    vdcs        = []
    rack_position = 21
    rack_face     = "front"
  },
  # US East — Access switch (standalone)
  "use_acc_sw01" = {
    name        = "USE-ACC-SW01"
